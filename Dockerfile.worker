# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# Growly automation worker (Python + InstaPy + headless Firefox).
#
# Build:
#   docker build -f Dockerfile.worker -t growly-worker .
#
# Run:
#   docker run --env-file .env -e WORKER_API_URL=http://web:3000 growly-worker
#
# Firefox is installed as `firefox-esr` and symlinked to `firefox`, because
# InstaPy discovers the browser with `shutil.which("firefox")`. geckodriver is
# fetched from GitHub; override GECKODRIVER_URL with a mirror if GitHub is
# blocked where the image is built.
# ---------------------------------------------------------------------------

FROM python:3.11-slim-bookworm

ARG GECKODRIVER_VERSION=0.35.0
ARG GECKODRIVER_URL=https://github.com/mozilla/geckodriver/releases/download

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      firefox-esr \
      xvfb \
      ca-certificates \
      curl \
      bzip2 \
      fonts-liberation \
 && rm -rf /var/lib/apt/lists/* \
 && ln -sf /usr/bin/firefox-esr /usr/local/bin/firefox \
 && curl -fsSL "${GECKODRIVER_URL}/v${GECKODRIVER_VERSION}/geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz" \
      | tar -xz -C /usr/local/bin \
 && chmod +x /usr/local/bin/geckodriver \
 && geckodriver --version

WORKDIR /app

# Install dependencies first so they are cached across code changes.
COPY instapy-00/requirements.txt ./instapy-00/requirements.txt
COPY worker/requirements.txt ./worker/requirements.txt
RUN pip install --no-cache-dir \
      -r instapy-00/requirements.txt \
      -r worker/requirements.txt

COPY instapy-00 ./instapy-00
COPY worker ./worker

# Headless Firefox by default; Xvfb is started as a fallback if you set
# WORKER_HEADLESS=false.
ENV WORKER_HEADLESS=true
ENV INSTAPY_PATH=/app/instapy-00
ENV DISPLAY=:99

CMD ["sh", "-c", "Xvfb :99 -screen 0 1280x1024x24 >/tmp/xvfb.log 2>&1 & exec python -m worker"]
