# ---------------------------------------------------------------------------
# Growly worker — environment for a worker-only VPS.
#
#   cp deploy/worker.env.example .env
#   nano .env                    # fill WORKER_API_URL + the two shared secrets
#   docker compose up -d --build worker
#
# The worker never talks to Postgres directly, so no DATABASE_URL or Supabase
# keys are needed here. The two secrets MUST match the web app exactly.
# ---------------------------------------------------------------------------

# Public URL of the web app (Netlify / Render / your VPS).
WORKER_API_URL="https://<your-site>.netlify.app"

# Shared with the web app: Site configuration -> WORKER_API_TOKEN (64 hex).
WORKER_API_TOKEN="<64-char-hex>"

# Shared with the web app: same CREDENTIALS_ENCRYPTION_KEY (44-char base64).
# The worker decrypts Instagram credentials that the web app encrypted.
CREDENTIALS_ENCRYPTION_KEY="<base64-32-bytes>"

WORKER_NAME="worker-1"
# Seconds between polls. 60 is fine and saves Netlify function invocations.
WORKER_POLL_SECONDS="60"
WORKER_CONCURRENCY="1"
INSTAPY_PATH="./instapy-00"
WORKER_HEADLESS="true"

# Optional HTTP(S) proxy fallback. A European VPS usually reaches Instagram
# directly; set this if Instagram blocks the VPS IP or returns
# checkpoint_required. HTTP(S) only — InstaPy does not support SOCKS.
# WORKER_DEFAULT_PROXY="http://user:pass@proxy-host:8080"