# Caddy reverse proxy for Growly.
#
# Caddy fetches and renews TLS certificates automatically, which is why it is a
# good fit for a single free VM. Replace `example.com` with your domain (or, if
# you only have the VM's public IP, use `:80` and drop the domain).
#
#   sudo apt install -y caddy
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

example.com {
	encode zstd gzip

	# Optional: keep the worker API private to the VM. If the worker runs on the
	# same host it can call http://127.0.0.1:3000 directly and this block can be
	# removed so the API is never exposed to the internet.
	@worker path /api/worker/*
	handle @worker {
		# Only allow localhost (uncomment to enforce):
		# @notlocal not remote_ip 127.0.0.1
		# respond @notlocal 403
		reverse_proxy 127.0.0.1:3000
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
