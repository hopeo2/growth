# ---------------------------------------------------------------------------
# Growly — environment variables TEMPLATE
#
# ⚠️  THIS FILE IS COMMITTED TO GIT. NEVER put real keys or passwords here.
#     Real values belong in `.env` (a hidden file — `ls -la` shows it):
#         cp .env.example .env
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) -----------------------------------------
# Two different connection strings are needed:
#
#   Runtime (web app) :  Transaction pooler, port 6543
#                        (src/db/index.ts already sets `prepare: false`)
#   DDL (`npm run db:push`) :  Session pooler, port 5432
#                        New Supabase projects are IPv6-only on the "Direct"
#                        connection, so the Session pooler (IPv4) is the safe
#                        choice for migrations from most networks.
#
# Do NOT add `?pgbouncer=true`: that is a Prisma-only flag. postgres.js forwards
# unknown query parameters to Postgres as startup options, and the server
# rejects them ("unrecognized configuration parameter").
# Percent-encode characters that are invalid in a URL userinfo, e.g. @ -> %40.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Optional: max pooled connections per web process (default 5).
# DATABASE_POOL_MAX="5"

# --- Supabase Auth --------------------------------------------------------
# Supabase renamed its keys:
#   old "anon" key         -> new "publishable" key  (sb_publishable_...)
#   old "service_role" key -> new "secret" key       (sb_secret_...)
#
# Paste the publishable/anon value into both *_ANON_KEY variables below.
# The *_PUBLISHABLE_KEY / *_SECRET_KEY names are also accepted by the code.
#
# The VITE_* copies are baked into the browser bundle at build time; the app
# server reads the non-prefixed ones and falls back to the VITE_* values.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<publishable-or-anon-key>"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<publishable-or-anon-key>"
# Server-only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY="<secret-or-service-role-key>"

# --- Secrets --------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Must be identical for the web app and the worker: the worker decrypts
# Instagram credentials that the web app encrypted with this key.
CREDENTIALS_ENCRYPTION_KEY="<base64-32-bytes>"
# Shared bearer token for /api/worker/*. Generate with: openssl rand -hex 32
# Must match on both the web app and the worker.
WORKER_API_TOKEN="<random-hex>"

# --- Web app --------------------------------------------------------------
# Public origin used for CSRF origin checks. Use the exact browser origin,
# without a trailing slash. Local dev: http://localhost:3000
# Deployed (Render): https://<your-service>.onrender.com
APP_ORIGIN="http://localhost:3000"
PORT="3000"

# --- Bootstrap admin ------------------------------------------------------
# Comma-separated emails promoted to admin on first login.
# Use the email you will sign up with.
ADMIN_EMAILS="you@example.com"

# --- Worker (read by worker/config.py) ------------------------------------
WORKER_NAME="worker-1"
WORKER_POLL_SECONDS="20"
# Keep at 1: each worker process runs one headless Firefox per job.
WORKER_CONCURRENCY="1"
# Base URL the worker calls. Falls back to APP_ORIGIN, then
# http://localhost:3000. Docker Compose defaults it to http://web:3000.
# When the web app is on Render, set this to the public URL:
# WORKER_API_URL="https://<your-service>.onrender.com"
# Path to the InstaPy checkout. The worker Docker image sets this itself.
INSTAPY_PATH="./instapy-00"
# Run Firefox headless (recommended on servers).
WORKER_HEADLESS="true"
# Fallback HTTP(S) proxy (user:pass@host:port) used for accounts that don't
# have their own proxy. HTTP(S) only — InstaPy does not support SOCKS.
# Required when the worker's IP cannot reach Instagram (e.g. Iran) or when
# Instagram blocks the datacenter IP.
# WORKER_DEFAULT_PROXY="http://user:pass@proxy-host:8080"