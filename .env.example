# ---------------------------------------------------------------------------
# Growly — environment variables
# Copy to `.env` and fill in. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Supabase Postgres connection string. Use the *transaction pooler* (port 6543)
# for the web app; drizzle-kit migrations can use the direct connection (5432).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# --- Supabase Auth --------------------------------------------------------
# The VITE_* copies are bundled into the browser build; the app server reads
# the non-prefixed ones and falls back to the VITE_* values.
#
# Supabase renamed its keys:
#   old "anon" key         -> new "publishable" key  (sb_publishable_...)
#   old "service_role" key -> new "secret" key       (sb_secret_...)
# Put the publishable/anon value in VITE_SUPABASE_ANON_KEY and SUPABASE_ANON_KEY
# (legacy names are kept in code; the *_PUBLISHABLE_KEY / *_SECRET_KEY names
# also work if you prefer them).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<publishable-or-anon-key>"
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<publishable-or-anon-key>"
# Server-only. Never expose this to the browser. (Optional for now: nothing
# reads it yet, but keep it for admin/service tasks.)
SUPABASE_SERVICE_ROLE_KEY="<secret-or-service-role-key>"

# --- Secrets --------------------------------------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="<base64-32-bytes>"
# Shared bearer token the Python worker uses to call /api/worker/*.
# Generate with: openssl rand -hex 32
WORKER_API_TOKEN="<random-hex>"

# --- Web app --------------------------------------------------------------
# Public origin of the deployed app (used for CSRF origin checks).
APP_ORIGIN="http://localhost:3000"
PORT="3000"

# --- Bootstrap admin ------------------------------------------------------
# Comma-separated emails that become admins on first login.
ADMIN_EMAILS="you@example.com"

# --- Worker (read by worker/config.py) ------------------------------------
WORKER_NAME="worker-1"
WORKER_POLL_SECONDS="20"
WORKER_CONCURRENCY="1"
# Base URL the worker calls. Defaults to APP_ORIGIN; with docker compose it is
# set to http://web:3000 automatically.
# WORKER_API_URL="http://127.0.0.1:3000"
# Path to the InstaPy checkout.
INSTAPY_PATH="./instapy-00"
# Run Firefox headless (recommended on servers).
WORKER_HEADLESS="true"
# Fallback HTTP(S) proxy (user:pass@host:port) used for accounts that don't
# have their own proxy. Instagram is blocked in some countries (e.g. Iran) and
# many datacenter IPs are blocked by Instagram, so a proxy is usually required.
# WORKER_DEFAULT_PROXY="http://user:pass@proxy-host:8080"
